    <bpmn:messageFlow id="Flow_CRM_Out" sourceRef="Activity_0zqqnr1" targetRef="Event_1czzyau" />
    <bpmn:messageFlow id="Flow_CRM_In" sourceRef="Event_1ni06sk" targetRef="Activity_0xi3dd9" />
  </bpmn:collaboration>
  <bpmn:process id="Process_00qvb5l" name="Платформа обучения" isExecutable="true" camunda:historyTimeToLive="180">
    <bpmn:laneSet id="LaneSet_01">
      <bpmn:lane id="Lane_Student" name="Пользователь - Студент">
