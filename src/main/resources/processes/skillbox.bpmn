        <bpmn:flowNodeRef>Activity_1vpuw3v</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Activity_0lz67hj</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Mentor" name="Куратор - Ментор">
        <bpmn:flowNodeRef>Activity_1dp1wgk</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Activity_0ajyj54</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <!-- Student: Start & Course Purchase / 1C Check -->
    <bpmn:startEvent id="Event_1soofz9" name="Начало">
      <bpmn:outgoing>Flow_0z97hmj</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="Activity_0xaefje" name="Начало блока курса">
      <bpmn:incoming>Flow_0z97hmj</bpmn:incoming>
      <bpmn:outgoing>Flow_To_CRM_Req</bpmn:outgoing>
    </bpmn:task>
    <bpmn:serviceTask id="Activity_0zqqnr1" name="Формирование запроса к 1С" camunda:expression="${true}">
      <bpmn:incoming>Flow_To_CRM_Req</bpmn:incoming>
      <bpmn:outgoing>Flow_From_CRM_Req</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Activity_0xi3dd9" name="Открытие доступа к курсу" camunda:expression="${true}">
      <bpmn:incoming>Flow_From_CRM_Req</bpmn:incoming>
      <bpmn:outgoing>Flow_19zufg4</bpmn:outgoing>
    </bpmn:serviceTask>

    <!-- Student: Select Difficulty -->
    <bpmn:userTask id="Activity_0664flp" name="Выбор сложности блока" camunda:formRef="select-difficulty" camunda:formRefBinding="latest" camunda:candidateGroups="ROLE_USER,ROLE_ADMIN">
      <bpmn:incoming>Flow_19zufg4</bpmn:incoming>
      <bpmn:outgoing>Flow_1qqmaou</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Backend: Resolve Coefficient -->
    <bpmn:exclusiveGateway id="Gateway_0388nwb" name="Уровень сложности?" default="Flow_0xvurmf">
      <bpmn:incoming>Flow_1qqmaou</bpmn:incoming>
      <bpmn:outgoing>Flow_0pbf1tn</bpmn:outgoing>
      <bpmn:outgoing>Flow_1xvdw45</bpmn:outgoing>
      <bpmn:outgoing>Flow_0xvurmf</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="Activity_0ujyb5p" name="Установить коэффициент = x2.0" camunda:delegateExpression="${resolveCoefficientDelegate}">
      <bpmn:incoming>Flow_0pbf1tn</bpmn:incoming>
      <bpmn:outgoing>Flow_1jit6wg</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Activity_1qs93wg" name="Установить коэффициент = x1.5" camunda:delegateExpression="${resolveCoefficientDelegate}">
      <bpmn:incoming>Flow_1xvdw45</bpmn:incoming>
      <bpmn:outgoing>Flow_0zaihcu</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Activity_0ajhbu1" name="Установить коэффициент = x1.0" camunda:delegateExpression="${resolveCoefficientDelegate}">
      <bpmn:incoming>Flow_0xvurmf</bpmn:incoming>
      <bpmn:outgoing>Flow_0jjl3af</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Gateway_08cfj1s">
      <bpmn:incoming>Flow_1jit6wg</bpmn:incoming>
      <bpmn:incoming>Flow_0zaihcu</bpmn:incoming>
      <bpmn:incoming>Flow_0jjl3af</bpmn:incoming>
      <bpmn:outgoing>Flow_0wv24pe</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Student: Open Block -->
    <bpmn:userTask id="Activity_04ukpzf" name="Выбор блока" camunda:formRef="open-block" camunda:formRefBinding="latest" camunda:candidateGroups="ROLE_USER,ROLE_ADMIN">
      <bpmn:incoming>Flow_0wv24pe</bpmn:incoming>
      <bpmn:incoming>Flow_0jppdgs</bpmn:incoming>
      <bpmn:incoming>Flow_BackToBlock</bpmn:incoming>
      <bpmn:outgoing>Flow_105z9fa</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:intermediateCatchEvent id="Event_BackToBlock_Target" name="BackToBlock">
      <bpmn:outgoing>Flow_BackToBlock</bpmn:outgoing>
      <bpmn:linkEventDefinition id="LinkEventDefinition_catch_01" name="BackToBlock" />
    </bpmn:intermediateCatchEvent>

    <!-- Backend: Check Points & Deduct -->
    <bpmn:exclusiveGateway id="Gateway_05bjbml" name="Достаточно баллов для открытия?" default="Flow_0c9ikuj">
      <bpmn:incoming>Flow_105z9fa</bpmn:incoming>
      <bpmn:outgoing>Flow_0c9ikuj</bpmn:outgoing>
      <bpmn:outgoing>Flow_17q8al5</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="Activity_1yaxb3n" name="Списание баллов за открытие блока" camunda:delegateExpression="${deductPointsAndOpenBlockDelegate}">
      <bpmn:incoming>Flow_0c9ikuj</bpmn:incoming>
      <bpmn:outgoing>Flow_ToTasks</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sendTask id="Activity_174cjbu" name="Уведомление: недостаточно баллов" camunda:expression="${true}">
      <bpmn:incoming>Flow_17q8al5</bpmn:incoming>
      <bpmn:outgoing>Flow_09zrsxs</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:intermediateThrowEvent id="Event_0237xdf" name="Перенаправление на прошлый блок">
      <bpmn:incoming>Flow_09zrsxs</bpmn:incoming>
      <bpmn:linkEventDefinition id="LinkEventDefinition_0eo7npz" name="BackToBlock" />
    </bpmn:intermediateThrowEvent>

    <!-- Student: Choose & Submit Task -->
    <bpmn:userTask id="Activity_09eyeot" name="Выбор задания" camunda:candidateGroups="ROLE_USER,ROLE_ADMIN">
      <bpmn:incoming>Flow_ToTasks</bpmn:incoming>
      <bpmn:incoming>Flow_0mh9zlw</bpmn:incoming>
      <bpmn:outgoing>Flow_1wy6cnk</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Activity_0sgoo49" name="Выполнение задания" camunda:candidateGroups="ROLE_USER,ROLE_ADMIN">
      <bpmn:incoming>Flow_1wy6cnk</bpmn:incoming>
      <bpmn:incoming>Flow_0sqom42</bpmn:incoming>
      <bpmn:outgoing>Flow_08huqsj</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Activity_0bhlj02" name="Завершение задания" camunda:formRef="submit-task" camunda:formRefBinding="latest" camunda:candidateGroups="ROLE_USER,ROLE_ADMIN">
      <bpmn:incoming>Flow_08huqsj</bpmn:incoming>
      <bpmn:outgoing>Flow_1u4g8zc</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Backend: Check Required Review (Gateway_0aa6a5z) -->
    <bpmn:exclusiveGateway id="Gateway_0aa6a5z" name="Задание требует проверки?" default="Flow_03pptil">
      <bpmn:incoming>Flow_1u4g8zc</bpmn:incoming>
      <bpmn:outgoing>Flow_17bfqco</bpmn:outgoing>
      <bpmn:outgoing>Flow_03pptil</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Backend: Curator or System (Gateway_1f2z01j) -->
    <bpmn:exclusiveGateway id="Gateway_1f2z01j" name="Куратором или системой?" default="Flow_0a6cntz">
      <bpmn:incoming>Flow_17bfqco</bpmn:incoming>
      <bpmn:outgoing>Flow_09w8ba9</bpmn:outgoing>
      <bpmn:outgoing>Flow_0a6cntz</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="Activity_1phiz1k" name="Отправка на проверку куратору" camunda:expression="${true}">
      <bpmn:incoming>Flow_09w8ba9</bpmn:incoming>
      <bpmn:outgoing>Flow_ToMentor</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Activity_0bcbhu5" name="Проверка ответов системой" camunda:delegateExpression="${autoReviewDelegate}">
      <bpmn:incoming>Flow_0a6cntz</bpmn:incoming>
      <bpmn:incoming>Flow_03pptil</bpmn:incoming>
      <bpmn:outgoing>Flow_AutoDone</bpmn:outgoing>
    </bpmn:serviceTask>

    <!-- Mentor: Review Task -->
    <bpmn:userTask id="Activity_1dp1wgk" name="Проверка задания" camunda:formRef="review-task" camunda:formRefBinding="latest" camunda:candidateGroups="ROLE_MENTOR,ROLE_ADMIN">
      <bpmn:incoming>Flow_ToMentor</bpmn:incoming>
      <bpmn:outgoing>Flow_1s81rhp</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Activity_0ajyj54" name="Отправка результатов системе" camunda:candidateGroups="ROLE_MENTOR,ROLE_ADMIN">
      <bpmn:incoming>Flow_1s81rhp</bpmn:incoming>
      <bpmn:outgoing>Flow_MentorDone</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Backend: Receive Results & Check Approval -->
    <bpmn:serviceTask id="Activity_1tbz034" name="Приём результатов от куратора" camunda:expression="${true}">
      <bpmn:incoming>Flow_MentorDone</bpmn:incoming>
      <bpmn:outgoing>Flow_MentorReceived</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Gateway_1oi6bvq" name="Успешно?" default="Flow_1sel5jv">
      <bpmn:incoming>Flow_AutoDone</bpmn:incoming>
      <bpmn:incoming>Flow_MentorReceived</bpmn:incoming>
      <bpmn:outgoing>Flow_1sel5jv</bpmn:outgoing>
      <bpmn:outgoing>Flow_0ode31o</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Retry Loop if Not Approved -->
    <bpmn:userTask id="Activity_1krtzen" name="Выбор перепройти или нет" camunda:candidateGroups="ROLE_USER,ROLE_ADMIN">
      <bpmn:incoming>Flow_0ode31o</bpmn:incoming>
      <bpmn:outgoing>Flow_0nzzsmp</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Gateway_0bjghlu" default="Flow_1txplht">
      <bpmn:incoming>Flow_0nzzsmp</bpmn:incoming>
      <bpmn:outgoing>Flow_1txplht</bpmn:outgoing>
      <bpmn:outgoing>Flow_0sqom42</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Backend: Check Retry Submission (Gateway_10o90ge) -->
    <bpmn:exclusiveGateway id="Gateway_10o90ge" name="Задание выполнено повторно?" default="Flow_180d2k0">
      <bpmn:incoming>Flow_1sel5jv</bpmn:incoming>
      <bpmn:outgoing>Flow_180d2k0</bpmn:outgoing>
      <bpmn:outgoing>Flow_0nno6qt</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="Activity_0c5mw4z" name="Списать баллы за прошлую попытку" camunda:delegateExpression="${subtractPreviousPointsDelegate}">
      <bpmn:incoming>Flow_0nno6qt</bpmn:incoming>
      <bpmn:outgoing>Flow_1cub0un</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Activity_0qrfxge" name="Начисление баллов&#10;(баллы × коэффициент)" camunda:delegateExpression="${awardPointsDelegate}">
      <bpmn:incoming>Flow_180d2k0</bpmn:incoming>
      <bpmn:incoming>Flow_1cub0un</bpmn:incoming>
      <bpmn:outgoing>Flow_Awarded</bpmn:outgoing>
    </bpmn:serviceTask>

    <!-- Student: Choose Action (Next Task, Complete Block) -->
    <bpmn:userTask id="Activity_0d6oih5" name="Выбор действия" camunda:candidateGroups="ROLE_USER,ROLE_ADMIN">
      <bpmn:incoming>Flow_1txplht</bpmn:incoming>
      <bpmn:incoming>Flow_Awarded</bpmn:incoming>
      <bpmn:outgoing>Flow_0j74l7z</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Gateway_090wqg2" default="Flow_0mh9zlw">
      <bpmn:incoming>Flow_0j74l7z</bpmn:incoming>
      <bpmn:outgoing>Flow_0ponmr3</bpmn:outgoing>
      <bpmn:outgoing>Flow_0mh9zlw</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Check Next Block (Gateway_146dyfp) -->
    <bpmn:exclusiveGateway id="Gateway_146dyfp" name="Есть следующий блок?" default="Flow_1tdvee2">
      <bpmn:incoming>Flow_0ponmr3</bpmn:incoming>
      <bpmn:outgoing>Flow_0jppdgs</bpmn:outgoing>
      <bpmn:outgoing>Flow_1tdvee2</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Course Completion & Certificate -->
    <bpmn:userTask id="Activity_0bl4s1r" name="Нажатие кнопки завершить курс" camunda:candidateGroups="ROLE_USER,ROLE_ADMIN">
      <bpmn:incoming>Flow_1tdvee2</bpmn:incoming>
      <bpmn:outgoing>Flow_11m1ku3</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="Activity_1vpuw3v" name="Формирование сертификата" camunda:delegateExpression="${generateCertificateDelegate}">
      <bpmn:incoming>Flow_11m1ku3</bpmn:incoming>
      <bpmn:outgoing>Flow_11p6fb5</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Activity_0lz67hj" name="Отправка пользователю сертификата на почту/ТГ" camunda:delegateExpression="${checkAndSendCertificateDelegate}">
      <bpmn:incoming>Flow_11p6fb5</bpmn:incoming>
      <bpmn:outgoing>Flow_0xa8tud</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="Event_0j3lta3" name="Конец курса">
      <bpmn:incoming>Flow_0xa8tud</bpmn:incoming>
      <bpmn:terminateEventDefinition id="TerminateEventDefinition_0bnx2tg" />
    </bpmn:endEvent>

    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="Flow_0z97hmj" sourceRef="Event_1soofz9" targetRef="Activity_0xaefje" />
    <bpmn:sequenceFlow id="Flow_To_CRM_Req" sourceRef="Activity_0xaefje" targetRef="Activity_0zqqnr1" />
    <bpmn:sequenceFlow id="Flow_From_CRM_Req" sourceRef="Activity_0zqqnr1" targetRef="Activity_0xi3dd9" />
    <bpmn:sequenceFlow id="Flow_19zufg4" sourceRef="Activity_0xi3dd9" targetRef="Activity_0664flp" />
    <bpmn:sequenceFlow id="Flow_1qqmaou" sourceRef="Activity_0664flp" targetRef="Gateway_0388nwb" />
    <bpmn:sequenceFlow id="Flow_0pbf1tn" name="Сложный" sourceRef="Gateway_0388nwb" targetRef="Activity_0ujyb5p">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${difficulty=='hard'}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_1xvdw45" name="Средний" sourceRef="Gateway_0388nwb" targetRef="Activity_1qs93wg">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${difficulty=='medium'}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_0xvurmf" name="Лёгкий" sourceRef="Gateway_0388nwb" targetRef="Activity_0ajhbu1" />
    <bpmn:sequenceFlow id="Flow_1jit6wg" sourceRef="Activity_0ujyb5p" targetRef="Gateway_08cfj1s" />
    <bpmn:sequenceFlow id="Flow_0zaihcu" sourceRef="Activity_1qs93wg" targetRef="Gateway_08cfj1s" />
    <bpmn:sequenceFlow id="Flow_0jjl3af" sourceRef="Activity_0ajhbu1" targetRef="Gateway_08cfj1s" />
    <bpmn:sequenceFlow id="Flow_0wv24pe" sourceRef="Gateway_08cfj1s" targetRef="Activity_04ukpzf" />
    <bpmn:sequenceFlow id="Flow_105z9fa" sourceRef="Activity_04ukpzf" targetRef="Gateway_05bjbml" />
    <bpmn:sequenceFlow id="Flow_BackToBlock" sourceRef="Event_BackToBlock_Target" targetRef="Activity_04ukpzf" />
    <bpmn:sequenceFlow id="Flow_0c9ikuj" name="Да" sourceRef="Gateway_05bjbml" targetRef="Activity_1yaxb3n" />
    <bpmn:sequenceFlow id="Flow_17q8al5" name="Нет" sourceRef="Gateway_05bjbml" targetRef="Activity_174cjbu">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${hasEnoughPoints==false}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_09zrsxs" sourceRef="Activity_174cjbu" targetRef="Event_0237xdf" />
    <bpmn:sequenceFlow id="Flow_ToTasks" sourceRef="Activity_1yaxb3n" targetRef="Activity_09eyeot" />
    <bpmn:sequenceFlow id="Flow_0mh9zlw" name="выбор задания" sourceRef="Gateway_090wqg2" targetRef="Activity_09eyeot" />
    <bpmn:sequenceFlow id="Flow_1wy6cnk" sourceRef="Activity_09eyeot" targetRef="Activity_0sgoo49" />
    <bpmn:sequenceFlow id="Flow_0sqom42" name="Да" sourceRef="Gateway_0bjghlu" targetRef="Activity_0sgoo49">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${choice=='retry'}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_08huqsj" sourceRef="Activity_0sgoo49" targetRef="Activity_0bhlj02" />
