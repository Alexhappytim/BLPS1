{
  "executionPlatform": "Camunda Platform",
  "executionPlatformVersion": "7.20.0",
  "exporter": {
    "name": "Camunda Modeler",
    "version": "5.20.0"
  },
  "schemaVersion": 16,
  "id": "action-choice",
  "components": [
    {
      "text": "### Выбор дальнейшего действия\n\nТекущая задача выполнена!\n\n- **Решить ещё одно задание этого блока** — продолжить практику в текущем блоке.\n- **Завершить текущий блок** — завершить блок. Если в курсе есть следующие блоки, откроется выбор следующего блока. Если это финальный блок курса — курс будет автоматически завершён с выдачей сертификата.\n- **Ожидать проверки куратора** — дождаться результатов проверки.",
      "type": "text",
      "id": "Field_header"
    },
    {
      "label": "Выберите следующее действие:",
      "type": "radio",
      "id": "Field_action",
      "key": "action",
      "defaultValue": "next_task",
      "values": [
        {
          "label": "Решить ещё одно задание этого блока",
          "value": "next_task"
        },
        {
          "label": "Завершить текущий блок",
          "value": "finish_block"
        },
        {
          "label": "Ожидать проверки куратора",
          "value": "wait_review"
        }
      ],
      "validate": {
        "required": true
      }
    }
  ],
  "type": "default"
}
