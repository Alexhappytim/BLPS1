{
  "executionPlatform": "Camunda Platform",
  "executionPlatformVersion": "7.22.0",
  "exporter": {
    "name": "Camunda Modeler",
    "version": "5.50.1"
  },
  "schemaVersion": 16,
  "id": "select-task",
  "type": "default",
  "components": [
    {
      "text": "### Выбор задания\nВыберите практическое задание вашего текущего блока курса (например, для Экспресс курса выберите задание 6).",
      "type": "text",
      "id": "Text_SelectTaskHeader"
    },
    {
      "label": "Выберите задание",
      "type": "select",
      "id": "Field_SelectedTaskId",
      "key": "taskId",
      "valuesKey": "availableTasks",
      "validate": {
        "required": true
      }
    }
  ]
}
